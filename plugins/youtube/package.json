{
  "name": "@boy-offi9-inc/tidepull-plugin-youtube",
  "version": "0.3.1",
  "type": "module",
  "description": "Tidepull plugin: extracts stream URLs from public YouTube videos and shorts with n-challenge + s-signature deciphering (yt-dlp ejs solver core) and browser-UA page fetching.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boy-offi9-inc/tidepull-plugins.git"
  },
  "main": "./dist-youtube.ts",
  "exports": {
    ".": "./dist-youtube.ts",
    "./source": "./index.ts"
  },
  "files": [
    "dist-youtube.ts",
    "solver-source.ts",
    "nsig.ts",
    "index.ts",
    "yt.solver.core.js",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "build": "node scripts/build-standalone.mjs"
  },
  "keywords": [
    "tidepull",
    "tidepull-plugin",
    "downloader",
    "youtube",
    "video"
  ],
  "peerDependencies": {
    "@boy-offi9-inc/tidepull": ">=0.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "astring": "^1.9.0",
    "meriyah": "^7.4.3"
  }
}